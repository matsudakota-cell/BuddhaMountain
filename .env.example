# Public — safe to expose to the browser (served via /api/config).
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Server-only — never expose to the browser, never commit the real value.
# Supabase dashboard: Project Settings > API > Secret keys.
SUPABASE_SECRET_KEY=sb_secret_...

# Optional — enables LLM-enhanced responses. Falls back to templated wisdom
# automatically if this is unset.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
